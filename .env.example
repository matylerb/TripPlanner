# All optional. The app runs fully without any of these.

# Gemini — when set, chat preference parsing uses Gemini via /api/ai.
# Drafting and booking search keep using the local planner until their prompts are wired up.
GEMINI_API_KEY=

# Google Maps — required by the trip map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Supabase — reserved for replacing the local/BroadcastChannel store with Realtime.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

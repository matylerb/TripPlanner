# All optional. The app runs fully without any of these.

# Gemini — the planning agent. Parses chat into preferences (flash) and drafts the
# whole itinerary (a lite model, for speed) via /api/ai. Without a key the local heuristic planner runs.
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
# Model used to draft itineraries. A lite model keeps drafts under ~10s. Defaults to gemini-flash-lite-latest.
GEMINI_DRAFT_MODEL=gemini-flash-lite-latest

# Google Maps JavaScript API key for the results-page map. This one is exposed
# to the browser, so restrict it by HTTP referrer in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Places API (New) — enable "Places API (New)" in Google Cloud Console
# https://console.cloud.google.com/apis/library/places.googleapis.com
GOOGLE_PLACES_API_KEY=

# Firebase (client)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escape sequences from the downloaded JSON's private_key field.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
